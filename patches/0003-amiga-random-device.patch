diff --git a/src/RandomDevice.h b/src/RandomDevice.h
new file mode 100644
index 0000000..eb07e33
--- /dev/null
+++ b/src/RandomDevice.h
@@ -0,0 +1,50 @@
+// -*- mode: c++; c-file-style: "linux"; c-basic-offset: 2; indent-tabs-mode: nil -*-
+/*! \file
+  The random device wxMaxima seeds its generators from.
+
+  AmigaOS has no /dev/urandom, so std::random_device cannot be made there.
+  On the Amiga it is a splitmix64 stream seeded from the clock, this
+  process's addresses and a running count. That's enough for wxMaxima's
+  uses: seeding generators and the secret it gives the Maxima it starts on
+  this machine.
+*/
+#ifndef WXM_RANDOMDEVICE_H
+#define WXM_RANDOMDEVICE_H
+#include <random>
+#if defined(__AMIGA__)
+#include <chrono>
+#include <cstdint>
+class WxmRandomDevice
+{
+public:
+  using result_type = unsigned int;
+  WxmRandomDevice()
+  {
+    m_state ^= static_cast<std::uint64_t>(
+      std::chrono::steady_clock::now().time_since_epoch().count());
+    m_state ^= static_cast<std::uint64_t>(
+      std::chrono::system_clock::now().time_since_epoch().count()) << 17;
+    m_state ^= reinterpret_cast<std::uintptr_t>(this);
+    m_state ^= reinterpret_cast<std::uintptr_t>(&s_count) << 32;
+    m_state += ++s_count * 0x9E3779B97F4A7C15ull;
+  }
+  static constexpr result_type min() { return 0; }
+  static constexpr result_type max() { return 0xFFFFFFFFu; }
+  double entropy() const noexcept { return 0.0; }
+  result_type operator()()
+  {
+    m_state += 0x9E3779B97F4A7C15ull ^ static_cast<std::uint64_t>(
+      std::chrono::steady_clock::now().time_since_epoch().count());
+    std::uint64_t z = m_state;
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+    return static_cast<result_type>((z ^ (z >> 31)) >> 16);
+  }
+private:
+  std::uint64_t m_state = 0x853C49E6748FEA9Bull;
+  static inline std::uint64_t s_count = 0;
+};
+#else
+using WxmRandomDevice = std::random_device;
+#endif
+#endif // WXM_RANDOMDEVICE_H
