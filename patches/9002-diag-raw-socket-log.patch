+// DIAG (lab only): the raw bytes both ways
+#include <cstdio>
+static void MxRaw(const char *file, const char *what, const char *data, std::size_t n) {
+  FILE *f = std::fopen(file, "ab");
+  if (!f) return;
+  long size = std::ftell(f);
+  std::fprintf(f, "\n==== %ld %s %lu bytes ====\n", (long)wxGetLocalTimeMillis().GetValue(), what, (unsigned long)n);
+  if (size < 400000) std::fwrite(data, 1, n > 4096 ? 4096 : n, f);
+  std::fclose(f);
+}
+
 wxDEFINE_EVENT(EVT_MAXIMA, wxThreadEvent);
 
